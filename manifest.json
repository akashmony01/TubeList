{
  "manifest_version": 3,
  "name": "TubeList",
  "version": "1.0.0",
  "description": "Replace YouTube's home feed with your own list of topics to learn about.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage"],

  "action": {
    "default_title": "TubeList",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "commands": {
    "open-tubelist": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open YouTube with TubeList, ready to add a topic"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content/youtube-selectors.css"],
      "js": [
        "shared/dom.js",
        "shared/topics.js",
        "shared/topic-list.js",
        "shared/settings.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/panel.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "tubelist@akashmony01.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
